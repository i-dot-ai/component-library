---
import Layout from "@layouts/Layout.astro";
---

<Layout>
    <div class="iai-toggle__item">
        <input class="iai-toggle__input" type="checkbox" role="switch" id="a" />
        <label class="govuk-label iai-toggle__label" for="a">Off toggle</label>
    </div>
    <div class="iai-toggle__item">
        <label class="govuk-label iai-toggle__label" for="b">Off toggle</label>
        <input class="iai-toggle__input" type="checkbox" role="switch" id="b" />
    </div>
</Layout>
