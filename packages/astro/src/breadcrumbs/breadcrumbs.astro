---
// AUTO-GENERATED from HTML spec. Do not edit by hand.
const { inverse = false, collapseOnMobile = false, class: className, ...rest } = Astro.props;

const classes = [
    "govuk-breadcrumbs",
    inverse ? "govuk-breadcrumbs--inverse" : "",
    collapseOnMobile ? "govuk-breadcrumbs--collapse-on-mobile" : "",
    className ?? "",
]
    .filter(Boolean)
    .join(" ");
---

<nav class={classes} aria-label="Breadcrumb" {...rest}>
    <ol class="govuk-breadcrumbs__list">
        <slot />
    </ol>
</nav>
