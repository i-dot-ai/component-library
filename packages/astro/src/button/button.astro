---
// AUTO-GENERATED from HTML spec. Do not edit by hand.
const { secondary = false, warning = false, inverse = false, href, class: className, ...rest } = Astro.props;

const classes = [
    "govuk-button",
    secondary ? "govuk-button--secondary" : "",
    warning ? "govuk-button--warning" : "",
    inverse ? "govuk-button--inverse" : "",
    className ?? "",
]
    .filter(Boolean)
    .join(" ");
---

{href ? (
<a href={href} role="button" class={classes} {...rest}>
    <slot />
</a>
) : (
<button class={classes} data-module="govuk-button" {...rest}>
    <slot />
</button>
)}
