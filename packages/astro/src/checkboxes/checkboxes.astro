---
const {
    small = false,
    subtle = false,
    class: className,
    ...rest
} = Astro.props;

const classes = [
    "govuk-checkboxes",
    small ? "govuk-checkboxes--small" : "",
    subtle ? "govuk-checkboxes--subtle" : "",
    className ?? "",
]
    .filter(Boolean)
    .join(" ");
---

<div class={classes} data-module="govuk-checkboxes" {...rest}>
    <slot />
</div>
