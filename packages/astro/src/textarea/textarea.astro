---
const {
    error = false,
    subtle = false,
    class: className,
    ...rest
} = Astro.props;

const classes = [
    "govuk-textarea",
    error ? "govuk-textarea--error" : "",
    subtle ? "govuk-textarea--subtle" : "",
    className ?? "",
]
    .filter(Boolean)
    .join(" ");
---

<textarea class={classes} {...rest}></textarea>
