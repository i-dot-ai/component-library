{
  "name": "@i-dot-ai-npm/component-library",
  "version": "0.0.1",
  "private": true,
  "description": "i.AI GOV.UK component library — HTML specs generated into per-framework packages.",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate": "node generator/index.mjs",
    "build": "pnpm --filter @i-dot-ai-npm/component-library-frontend build",
    "typecheck": "tsc --noEmit",
    "release": "npm run generate && npm run build && npm publish --workspaces --access public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "node-html-parser": "^7.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}